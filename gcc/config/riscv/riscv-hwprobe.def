RISCV_HWPROBE_EXT ("zicfilp",	RISCV_HWPROBE_KEY_IMA_EXT_0, 63, 0)

RISCV_HWPROBE_EXT ("zicfiss",	RISCV_HWPROBE_KEY_IMA_EXT_1,  0, 0)

#undef RISCV_HWPROBE_EXT

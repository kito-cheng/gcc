/* Before using #include to read this file, define a macro:

      RISCV_HWPROBE_EXT (NAME, KEY, BIT, FLAGS)

   NAME is the extension name as it appears in an ISA string.
   KEY is the hwprobe key whose value holds the bit.
   BIT is the bit position within that value.
   FLAGS is a bitmask of RISCV_HWPROBE_XLEN32 and friends, or 0.

   The key numbers and bit positions are a stable Linux ABI, mirroring
   <asm/hwprobe.h>.  They are replicated here so that the driver depends
   neither on the kernel headers nor on a glibc new enough to provide
   <sys/hwprobe.h>.

   RISCV_HWPROBE_IMA_FD covers both F and D, so bit 0 of IMA_EXT_0 gets two
   entries.  Extensions implied by others are listed anyway; the ISA string
   parser removes the redundancy.  */

RISCV_HWPROBE_EXT ("f",		RISCV_HWPROBE_KEY_IMA_EXT_0,  0, 0)
RISCV_HWPROBE_EXT ("d",		RISCV_HWPROBE_KEY_IMA_EXT_0,  0, 0)
RISCV_HWPROBE_EXT ("c",		RISCV_HWPROBE_KEY_IMA_EXT_0,  1, 0)
RISCV_HWPROBE_EXT ("v",		RISCV_HWPROBE_KEY_IMA_EXT_0,  2, 0)
RISCV_HWPROBE_EXT ("zba",	RISCV_HWPROBE_KEY_IMA_EXT_0,  3, 0)
RISCV_HWPROBE_EXT ("zbb",	RISCV_HWPROBE_KEY_IMA_EXT_0,  4, 0)
RISCV_HWPROBE_EXT ("zbs",	RISCV_HWPROBE_KEY_IMA_EXT_0,  5, 0)
RISCV_HWPROBE_EXT ("zicboz",	RISCV_HWPROBE_KEY_IMA_EXT_0,  6, 0)
RISCV_HWPROBE_EXT ("zbc",	RISCV_HWPROBE_KEY_IMA_EXT_0,  7, 0)
RISCV_HWPROBE_EXT ("zbkb",	RISCV_HWPROBE_KEY_IMA_EXT_0,  8, 0)
RISCV_HWPROBE_EXT ("zbkc",	RISCV_HWPROBE_KEY_IMA_EXT_0,  9, 0)
RISCV_HWPROBE_EXT ("zbkx",	RISCV_HWPROBE_KEY_IMA_EXT_0, 10, 0)
RISCV_HWPROBE_EXT ("zknd",	RISCV_HWPROBE_KEY_IMA_EXT_0, 11, 0)
RISCV_HWPROBE_EXT ("zkne",	RISCV_HWPROBE_KEY_IMA_EXT_0, 12, 0)
RISCV_HWPROBE_EXT ("zknh",	RISCV_HWPROBE_KEY_IMA_EXT_0, 13, 0)
RISCV_HWPROBE_EXT ("zksed",	RISCV_HWPROBE_KEY_IMA_EXT_0, 14, 0)
RISCV_HWPROBE_EXT ("zksh",	RISCV_HWPROBE_KEY_IMA_EXT_0, 15, 0)
RISCV_HWPROBE_EXT ("zkt",	RISCV_HWPROBE_KEY_IMA_EXT_0, 16, 0)
RISCV_HWPROBE_EXT ("zvbb",	RISCV_HWPROBE_KEY_IMA_EXT_0, 17, 0)
RISCV_HWPROBE_EXT ("zvbc",	RISCV_HWPROBE_KEY_IMA_EXT_0, 18, 0)
RISCV_HWPROBE_EXT ("zvkb",	RISCV_HWPROBE_KEY_IMA_EXT_0, 19, 0)
RISCV_HWPROBE_EXT ("zvkg",	RISCV_HWPROBE_KEY_IMA_EXT_0, 20, 0)
RISCV_HWPROBE_EXT ("zvkned",	RISCV_HWPROBE_KEY_IMA_EXT_0, 21, 0)
RISCV_HWPROBE_EXT ("zvknha",	RISCV_HWPROBE_KEY_IMA_EXT_0, 22, 0)
RISCV_HWPROBE_EXT ("zvknhb",	RISCV_HWPROBE_KEY_IMA_EXT_0, 23, 0)
RISCV_HWPROBE_EXT ("zvksed",	RISCV_HWPROBE_KEY_IMA_EXT_0, 24, 0)
RISCV_HWPROBE_EXT ("zvksh",	RISCV_HWPROBE_KEY_IMA_EXT_0, 25, 0)
RISCV_HWPROBE_EXT ("zvkt",	RISCV_HWPROBE_KEY_IMA_EXT_0, 26, 0)
RISCV_HWPROBE_EXT ("zfh",	RISCV_HWPROBE_KEY_IMA_EXT_0, 27, 0)
RISCV_HWPROBE_EXT ("zfhmin",	RISCV_HWPROBE_KEY_IMA_EXT_0, 28, 0)
RISCV_HWPROBE_EXT ("zihintntl",	RISCV_HWPROBE_KEY_IMA_EXT_0, 29, 0)

RISCV_HWPROBE_EXT ("zve64d",	RISCV_HWPROBE_KEY_IMA_EXT_0, 41, 0)
RISCV_HWPROBE_EXT ("zimop",	RISCV_HWPROBE_KEY_IMA_EXT_0, 42, 0)
RISCV_HWPROBE_EXT ("zca",	RISCV_HWPROBE_KEY_IMA_EXT_0, 43, 0)

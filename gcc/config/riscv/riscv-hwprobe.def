RISCV_HWPROBE_EXT ("zvfhmin",	RISCV_HWPROBE_KEY_IMA_EXT_0, 31, 0)
RISCV_HWPROBE_EXT ("zfa",	RISCV_HWPROBE_KEY_IMA_EXT_0, 32, 0)
RISCV_HWPROBE_EXT ("ztso",	RISCV_HWPROBE_KEY_IMA_EXT_0, 33, 0)
RISCV_HWPROBE_EXT ("zacas",	RISCV_HWPROBE_KEY_IMA_EXT_0, 34, 0)
RISCV_HWPROBE_EXT ("zicond",	RISCV_HWPROBE_KEY_IMA_EXT_0, 35, 0)
RISCV_HWPROBE_EXT ("zihintpause", RISCV_HWPROBE_KEY_IMA_EXT_0, 36, 0)
RISCV_HWPROBE_EXT ("zve32x",	RISCV_HWPROBE_KEY_IMA_EXT_0, 37, 0)
RISCV_HWPROBE_EXT ("zve32f",	RISCV_HWPROBE_KEY_IMA_EXT_0, 38, 0)

RISCV_HWPROBE_EXT ("zcd",	RISCV_HWPROBE_KEY_IMA_EXT_0, 45, 0)
RISCV_HWPROBE_EXT ("zcf",	RISCV_HWPROBE_KEY_IMA_EXT_0, 46,
		   RISCV_HWPROBE_XLEN32)
RISCV_HWPROBE_EXT ("zcmop",	RISCV_HWPROBE_KEY_IMA_EXT_0, 47, 0)
RISCV_HWPROBE_EXT ("zawrs",	RISCV_HWPROBE_KEY_IMA_EXT_0, 48, 0)
RISCV_HWPROBE_EXT ("supm",	RISCV_HWPROBE_KEY_IMA_EXT_0, 49, 0)
RISCV_HWPROBE_EXT ("zicntr",	RISCV_HWPROBE_KEY_IMA_EXT_0, 50, 0)
RISCV_HWPROBE_EXT ("zihpm",	RISCV_HWPROBE_KEY_IMA_EXT_0, 51, 0)
RISCV_HWPROBE_EXT ("zfbfmin",	RISCV_HWPROBE_KEY_IMA_EXT_0, 52, 0)
RISCV_HWPROBE_EXT ("zvfbfmin",	RISCV_HWPROBE_KEY_IMA_EXT_0, 53, 0)
RISCV_HWPROBE_EXT ("zvfbfwma",	RISCV_HWPROBE_KEY_IMA_EXT_0, 54, 0)
RISCV_HWPROBE_EXT ("zicbom",	RISCV_HWPROBE_KEY_IMA_EXT_0, 55, 0)
